<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.jwt_practice.auth.dao.RefreshTokenDao">
    <insert id="save" parameterType="RefreshToken">
        INSERT INTO refresh_token (user_id, token, expires_at) VALUES (#{userId}, #{token}, #{expiresAt});
    </insert>

    <select id="findByToken" parameterType="String" resultType="RefreshToken">
        SELECT * FROM refresh_token WHERE token = #{token}
    </select>

    <select id="findByUserId" parameterType="long" resultType="RefreshToken">
        SELECT * FROM refresh_token WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserId" parameterType="long">
        DELETE FROM refresh_token WHERE user_id = #{userId}
    </delete>
</mapper>